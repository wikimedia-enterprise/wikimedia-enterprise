  (*parser.Reference)({
    Identifier: (string) (len=12) "cite_note-23",
    Group: (string) "",
    Type: (string) (len=7) "journal",
    Metadata: (map[string]string) (len=11) {
      (string) (len=4) "date": (string) (len=4) "2016",
      (string) (len=3) "doi": (string) (len=15) "10.1002/ad.2050",
      (string) (len=5) "first": (string) (len=6) "Thomas",
