                (*parser.Part)({
                  Name: (string) "",
                  Type: (string) (len=9) "paragraph",
                  Value: (string) (len=150) "A est i russi avevano intanto conquistato la fortezza di Memel, mentre con molto opportunismo la Svezia aveva dichiarato guerra e invaso la Pomerania.",
                  Values: ([]string) <nil>,
                  HasParts: ([]*parser.Part) <nil>,
